   "source": [
    "## 4. Data Cleaning & Feature Engineering"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a0d8e1a5",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Fill missing Review Rating values using the median rating within each category\n",
    "df[\"Review Rating\"] = (\n",
    "    df.groupby(\"Category\")[\"Review Rating\"]\n",
    "      .transform(lambda x: x.fillna(x.median()))\n",
    ")\n",
    "\n",
    "df.isnull().sum()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0dc0efe9",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Standardize column names\n",
    "df.columns = df.columns.str.lower().str.replace(\" \", \"_\")\n",
    "\n",
    "# Make the purchase amount column easier to use\n",
    "df = df.rename(columns={\n",
    "    \"purchase_amount_(usd)\": \"purchase_amount\"\n",
    "})\n",
    "\n",
    "df.columns.tolist()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7522cc6f",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create age groups using quartiles\n",
    "labels = [\"Young Adult\", \"Adult\", \"Middle-aged\", \"Senior\"]\n",
    "\n",
    "df[\"age_group\"] = pd.qcut(\n",
    "    df[\"age\"],\n",
    "    q=4,\n",
    "    labels=labels\n",
    ")\n",
    "\n",
    "df[[\"age\", \"age_group\"]].head(10)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "30aeef94",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Convert purchase-frequency categories into approximate days\n",
    "frequency_mapping = {\n",
    "    \"Fortnightly\": 14,\n",
    "    \"Weekly\": 7,\n",
    "    \"Monthly\": 30,\n",
    "    \"Quarterly\": 90,\n",
    "    \"Bi-Weekly\": 14,\n",
    "    \"Annually\": 365,\n",
    "    \"Every 3 Months\": 90\n",
    "}\n",
    "\n",
    "df[\"purchase_frequency_days\"] = (\n",
    "    df[\"frequency_of_purchases\"].map(frequency_mapping)\n",
    ")\n",
    "\n",
    "df[[\"purchase_frequency_days\", \"frequency_of_purchases\"]].head(10)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0b21c546",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check whether Discount Applied and Promo Code Used contain the same information\n",
    "df[[\"discount_applied\", \"promo_code_used\"]].head(10)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "68132f68",
   "metadata": {},
   "outputs": [],
   "source": [
    "(df[\"discount_applied\"] == df[\"promo_code_used\"]).all()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3b2e81db",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Remove the redundant promo-code column\n",
    "df = df.drop(columns=[\"promo_code_used\"])\n",
    "\n",
    "df.columns.tolist()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5032a86c",
   "metadata": {},
   "source": [
    "## 5. SQL Integration"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f3dd4d25",
   "metadata": {},
   "source": [
    "The cleaned dataset can be loaded into PostgreSQL for SQL-based analysis.\n",
    "\n",
    "**Security note:** database credentials should never be hard-coded in a public GitHub notebook. The example below asks for the password interactively."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b6cfc192",
   "metadata": {},
   "outputs": [],
   "source": [
    "from sqlalchemy import create_engine\n",
    "from getpass import getpass\n",
    "from urllib.parse import quote_plus\n",
    "\n",
    "username = input(\"PostgreSQL username [postgres]: \").strip() or \"postgres\"\n",
    "password = getpass(\"PostgreSQL password: \")\n",
    "host = input(\"PostgreSQL host [localhost]: \").strip() or \"localhost\"\n",
    "port = input(\"PostgreSQL port [5432]: \").strip() or \"5432\"\n",
    "database = input(\"Database name [customer_1]: \").strip() or \"customer_1\"\n",
    "\n",
    "password_encoded = quote_plus(password)\n",
    "\n",
    "engine = create_engine(\n",
    "    f\"postgresql+psycopg2://{username}:{password_encoded}@{host}:{port}/{database}\"\n",
    ")\n",
    "\n",
    "table_name = \"customer\"\n",
    "\n",
    "df.to_sql(\n",
    "    table_name,\n",
    "    engine,\n",
    "    if_exists=\"replace\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "print(f\"Data successfully loaded into table '{table_name}'.\")"
   ]
  },
